# ══════════════════════════════════════════════════════════════════
#  UNDERNET.ONE — API
#  cp .env.example .env   i uzupełnij pola WPISZ_
# ══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4100

# Baza założona przez właściciela serwera.
DATABASE_URL="postgresql://undernet:WPISZ_HASLO_BAZY@127.0.0.1:5432/undernet?schema=public"

# Redis dzielony z xdtv.fans — ROZDZIELA NAS NUMER BAZY I PREFIKS.
# db0 należy do xdtv. Zmiana tych wartości na wspólne z xdtv pomieszałaby
# kolejki i sesje obu serwisów.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=2
REDIS_PREFIX="undernet:"

JWT_SECRET="WPISZ_LOSOWY_SEKRET"
JWT_EXPIRES_IN=30d

# Skąd frontend woła API — musi zgadzać się z portem frontu.
CORS_ORIGIN="https://undernet.one,http://127.0.0.1:3005"
PUBLIC_URL="https://undernet.one"

# Konto administratora zakładane przez `npm run seed`.
SEED_ADMIN_EMAIL="admin@undernet.one"
SEED_ADMIN_PASSWORD="WPISZ_HASLO_ADMINA"

# Poczta. Bez SMTP_HOST wysyłka idzie do logu i nikt nie potwierdzi konta.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="UNDERNET.ONE <noreply@undernet.one>"

# ── Logowanie kontem zewnętrznym ────────────────────────────────────────
# Puste pole = przycisk dostawcy nie pokazuje się na stronie logowania.
# Adres powrotu do wpisania w panelu dostawcy:
#   https://TWOJA-DOMENA/api/oauth/<dostawca>/callback
#
# Discord  → https://discord.com/developers/applications
# Google   → https://console.cloud.google.com/apis/credentials
# GitHub   → https://github.com/settings/developers
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Odświeżanie stron frontu ────────────────────────────────────────────
# Po każdym zapisie materiału API woła FRONTEND_INTERNAL_URL/api/revalidate.
# Ten sam sekret musi stać w .env.local frontu.
FRONTEND_INTERNAL_URL="http://127.0.0.1:3005"
REVALIDATE_SECRET="WPISZ_LOSOWY_SEKRET"

# Klucz dla wspólnego panelu AdminJS (puste = punkt wyłączony).
ADMIN_API_SECRET=""

# Tłumaczenia przez własną instancję LibreTranslate (opcjonalne).
LIBRETRANSLATE_URL="http://localhost:5000"

# ── Stripe (UNDERNET PRO) ───────────────────────────────────────────────
# PRO nadaje wyłącznie podpisany webhook: https://TWOJA-DOMENA/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTH=""
STRIPE_PRICE_PRO_YEAR=""
