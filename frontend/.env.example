# ══════════════════════════════════════════════════════════════════
#  UNDERNET.ONE — frontend
#  cp .env.example .env.local
# ══════════════════════════════════════════════════════════════════

# Adres API widziany Z SERWERA (pętla zwrotna). Przeglądarka używa
# ścieżek względnych /api i /uploads — nginx proksuje je pod tą samą domeną.
# NIE ustawiaj NEXT_PUBLIC_API_URL na adres wewnętrzny: trafiłby do paczki klienta.
INTERNAL_API_URL="http://127.0.0.1:4100"

NEXT_PUBLIC_SITE_URL="https://undernet.one"

# Musi być równy REVALIDATE_SECRET w .env backendu.
REVALIDATE_SECRET="WPISZ_LOSOWY_SEKRET"

# ── Opcjonalne ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Metryki Google Search Console pod /seo/search-console
SEO_METRICS_API_KEY=""
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""
GSC_SITE_URL=""
